{%- comment -%} image (image_picker), fallback (asset filename), alt, sizes, eager {%- endcomment -%}
{%- if image != blank -%}
  {%- if eager -%}
    {{ image | image_url: width: 1600 | image_tag: widths: '400,600,800,1000,1200,1600', sizes: sizes, alt: alt | default: image.alt, loading: 'eager', fetchpriority: 'high' }}
  {%- else -%}
    {{ image | image_url: width: 1600 | image_tag: widths: '400,600,800,1000,1200,1600', sizes: sizes, alt: alt | default: image.alt, loading: 'lazy' }}
  {%- endif -%}
{%- else -%}
  <img src="{{ fallback | default: 'fles-ijsblauw.svg' | asset_url }}" alt="{{ alt | escape }}" width="800" height="800"{% if eager %} fetchpriority="high"{% else %} loading="lazy"{% endif %}>
{%- endif -%}
