<div class="cart-summary__row"><span>{{ 'cart.subtotal' | t }}</span><span>{{ cart.items_subtotal_price | money }}</span></div>
{%- for d in cart.cart_level_discount_applications -%}
  <div class="cart-summary__row"><span>{{ d.title }}</span><span>−{{ d.total_allocated_amount | money }}</span></div>
{%- endfor -%}
<div class="cart-summary__row cart-summary__total"><span>{{ 'cart.total' | t }}</span><span>{{ cart.total_price | money }}</span></div>
<p class="cart-summary__note">{{ 'cart.taxes_shipping' | t }}{% if settings.shipping_text != blank %} {{ settings.shipping_text }}.{% endif %}</p>
