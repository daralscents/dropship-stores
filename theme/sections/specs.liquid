<section class="section {{ section.settings.style }}">
  <div class="container media-text media-text--reverse">
    <div class="media-text__media" style="background:transparent">
      {% render 'media-or-fallback', image: section.settings.image, fallback: section.settings.fallback, alt: section.settings.heading, sizes: '(min-width: 990px) 50vw, 100vw' %}
    </div>
    <div>
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {{ section.settings.text }}
      <dl class="spec-list">
        {%- for block in section.blocks -%}
          {%- if block.settings.value != blank -%}
          <div class="spec-list__row" {{ block.shopify_attributes }}><dt>{{ block.settings.label }}</dt><dd>{{ block.settings.value }}</dd></div>
          {%- endif -%}
        {%- endfor -%}
      </dl>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Kenmerken / specificaties",
  "settings": [
    { "type": "select", "id": "style", "label": "Achtergrond", "options": [ {"value":"","label":"Zand"}, {"value":"section--surface","label":"Klei"}, {"value":"section--white","label":"Wit"} ], "default": "" },
    { "type": "text", "id": "eyebrow", "label": "Bovenkop", "default": "In één oogopslag" },
    { "type": "text", "id": "heading", "label": "Kop", "default": "Wat zit erop en eraan" },
    { "type": "richtext", "id": "text", "label": "Tekst" },
    { "type": "image_picker", "id": "image", "label": "Afbeelding" },
    { "type": "text", "id": "fallback", "label": "Reserve-afbeelding (asset)", "default": "fles-krijtwit.svg" }
  ],
  "blocks": [ { "type": "spec", "name": "Kenmerk", "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Kenmerk" },
    { "type": "text", "id": "value", "label": "Waarde", "info": "Leeg = niet tonen. Vul alleen geverifieerde gegevens in." }
  ] } ],
  "presets": [ { "name": "Kenmerken / specificaties" } ]
}
{% endschema %}
