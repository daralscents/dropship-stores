<section class="section {{ section.settings.style }}">
  <div class="container text-center">
    <h2>{{ section.settings.heading }}</h2>
    <div class="lead" style="max-width:560px;margin:0 auto 24px">{{ section.settings.text }}</div>
    {%- assign form_id = 'Newsletter-' | append: section.id -%}
    {%- form 'customer', id: form_id -%}
      <input type="hidden" name="contact[tags]" value="newsletter,{{ section.settings.tag }}">
      {%- if form.posted_successfully? -%}
        <p class="form-success" role="status" style="max-width:520px;margin:0 auto">{{ 'newsletter.success' | t }}</p>
      {%- else -%}
        {%- if form.errors -%}<div class="form-errors" role="alert" style="max-width:520px;margin:0 auto 12px">{{ form.errors | default_errors }}</div>{%- endif -%}
        <div class="newsletter-form">
          <label for="NewsletterEmail-{{ section.id }}" class="visually-hidden">{{ 'newsletter.label' | t }}</label>
          <input id="NewsletterEmail-{{ section.id }}" class="input" type="email" name="contact[email]" autocomplete="email" required placeholder="{{ 'newsletter.label' | t }}">
          <button type="submit" class="btn btn--primary">{{ 'newsletter.submit' | t }}</button>
        </div>
        <p class="small" style="margin-top:12px">{{ 'newsletter.consent' | t }}</p>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>
{% schema %}
{
  "name": "Nieuwsbrief",
  "settings": [
    { "type": "select", "id": "style", "label": "Achtergrond", "options": [ {"value":"","label":"Zand"}, {"value":"section--surface","label":"Klei"}, {"value":"section--white","label":"Wit"} ], "default": "section--surface" },
    { "type": "text", "id": "heading", "label": "Kop", "default": "Wandeltips voor jou en je hond" },
    { "type": "richtext", "id": "text", "label": "Tekst", "default": "<p>Af en toe een mail met routes, zomer- en wintertips en nieuwe Lobbes-producten. Geen spam.</p>" },
    { "type": "text", "id": "tag", "label": "Extra tag", "default": "home" }
  ],
  "presets": [ { "name": "Nieuwsbrief" } ]
}
{% endschema %}
