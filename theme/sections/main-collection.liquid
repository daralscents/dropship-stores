<section class="page-wrap">
  <div class="container">
    <h1 class="page-title">{% if collection.title != blank %}{{ collection.title }}{% else %}{{ 'collection.all' | t }}{% endif %}</h1>
    {%- if collection.description != blank -%}<div class="rte lead" style="margin-bottom:32px">{{ collection.description }}</div>{%- endif -%}
    {%- paginate collection.products by 24 -%}
      {%- if collection.products.size > 0 -%}
        <div class="grid grid--3">
          {%- for product in collection.products -%}{% render 'product-card', product: product %}{%- endfor -%}
        </div>
      {%- else -%}
        <p>{{ 'collection.empty' | t }}</p>
      {%- endif -%}
      {%- if paginate.pages > 1 -%}
        <nav class="pagination" aria-label="Paginering">
          {%- if paginate.previous -%}<a class="btn btn--secondary" href="{{ paginate.previous.url }}">{{ 'general.pagination.previous' | t }}</a>{%- endif -%}
          {%- if paginate.next -%}<a class="btn btn--secondary" href="{{ paginate.next.url }}">{{ 'general.pagination.next' | t }}</a>{%- endif -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>
{% schema %}
{ "name": "Collectie", "settings": [] }
{% endschema %}
