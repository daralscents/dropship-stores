<section class="section {{ section.settings.style }}"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor }}"{% endif %}>
  <div class="container">
    <div class="section-head">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="lead">{{ section.settings.text }}</div>{%- endif -%}
    </div>
    <div class="grid grid--{{ section.settings.columns }}">
      {%- for block in section.blocks -%}
        <div class="card" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="card__media">{{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400,600,800', sizes: '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 100vw' }}</div>
          {%- elsif block.settings.icon != 'none' -%}
            <div class="card__icon">{% render 'icon', name: block.settings.icon %}</div>
          {%- endif -%}
          <h3>{{ block.settings.title }}</h3>
          {{ block.settings.text }}
        </div>
      {%- endfor -%}
    </div>
    {%- if section.settings.button_label != blank -%}
      <p class="text-center" style="margin-top:36px"><a class="btn btn--primary" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a></p>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Kaarten (voordelen)",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anker-ID (voor links, zonder #)" },
    { "type": "select", "id": "style", "label": "Achtergrond", "options": [ {"value":"","label":"Zand"}, {"value":"section--surface","label":"Klei"}, {"value":"section--white","label":"Wit"}, {"value":"section--primary","label":"Bosgroen"} ], "default": "" },
    { "type": "text", "id": "eyebrow", "label": "Bovenkop" },
    { "type": "text", "id": "heading", "label": "Kop", "default": "Waarom de Onderweg-fles" },
    { "type": "richtext", "id": "text", "label": "Intro" },
    { "type": "select", "id": "columns", "label": "Kolommen", "options": [ {"value":"2","label":"2"}, {"value":"3","label":"3"}, {"value":"4","label":"4"} ], "default": "4" },
    { "type": "text", "id": "button_label", "label": "Knop" },
    { "type": "url", "id": "button_link", "label": "Knop link" }
  ],
  "blocks": [
    { "type": "card", "name": "Kaart", "settings": [
      { "type": "select", "id": "icon", "label": "Icoon", "options": [ {"value":"none","label":"Geen"}, {"value":"check","label":"Vinkje"}, {"value":"drop","label":"Druppel"}, {"value":"bowl","label":"Voerbak"}, {"value":"hand","label":"Hand"}, {"value":"lock","label":"Slot"}, {"value":"paw","label":"Poot"}, {"value":"route","label":"Route"}, {"value":"car","label":"Auto"}, {"value":"sun","label":"Zon"}, {"value":"treat","label":"Snack"}, {"value":"gift","label":"Cadeau"}, {"value":"truck","label":"Verzending"}, {"value":"return","label":"Retour"}, {"value":"shield","label":"Garantie"}, {"value":"chat","label":"Service"} ], "default": "paw" },
      { "type": "image_picker", "id": "image", "label": "Afbeelding (vervangt icoon)" },
      { "type": "text", "id": "title", "label": "Titel", "default": "Titel" },
      { "type": "richtext", "id": "text", "label": "Tekst", "default": "<p>Tekst</p>" }
    ] }
  ],
  "presets": [ { "name": "Kaarten (voordelen)" } ]
}
{% endschema %}
