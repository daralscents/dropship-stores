{%- if section.settings.text != blank -%}
<div class="announcement" role="region" aria-label="Mededeling">
  {%- if section.settings.link != blank -%}<a href="{{ section.settings.link }}">{{ section.settings.text }}</a>{%- else -%}{{ section.settings.text }}{%- endif -%}
</div>
{%- endif -%}
{% schema %}
{
  "name": "Aankondigingsbalk",
  "settings": [
    { "type": "text", "id": "text", "label": "Tekst", "default": "Gratis verzending naar Nederland en België" },
    { "type": "url", "id": "link", "label": "Link" }
  ]
}
{% endschema %}
