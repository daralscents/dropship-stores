<section class="page-wrap">
  <div class="container">
    <h1 class="page-title">{{ 'search.title' | t }}</h1>
    <form action="{{ routes.search_url }}" method="get" role="search" class="newsletter-form" style="margin:0 0 32px;max-width:640px">
      <label for="SearchQ" class="visually-hidden">{{ 'search.placeholder' | t }}</label>
      <input id="SearchQ" class="input" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}">
      <input type="hidden" name="options[prefix]" value="last">
      <button class="btn btn--primary" type="submit">{{ 'general.search' | t }}</button>
    </form>
    {%- if search.performed -%}
      {%- paginate search.results by 24 -%}
        <p role="status">{%- if search.results_count > 0 -%}{{ 'search.results' | t: count: search.results_count, terms: search.terms }}{%- else -%}{{ 'search.none' | t: terms: search.terms }}{%- endif -%}</p>
        <div class="grid grid--3">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', product: item %}
            {%- else -%}
              <a class="article-card" href="{{ item.url }}"><div class="article-card__body"><h2 class="h3">{{ item.title }}</h2><p>{{ item.content | strip_html | truncatewords: 24 }}</p></div></a>
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- if paginate.pages > 1 -%}
          <nav class="pagination" aria-label="Paginering">
            {%- if paginate.previous -%}<a class="btn btn--secondary" href="{{ paginate.previous.url }}">{{ 'general.pagination.previous' | t }}</a>{%- endif -%}
            {%- if paginate.next -%}<a class="btn btn--secondary" href="{{ paginate.next.url }}">{{ 'general.pagination.next' | t }}</a>{%- endif -%}
          </nav>
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</section>
{% schema %}
{ "name": "Zoekresultaten", "settings": [] }
{% endschema %}
