{%- assign menu = linklists[section.settings.menu] -%}
<header class="header">
  <div class="container header__inner">
    <button type="button" class="icon-btn header__menu-toggle" data-menu-open aria-controls="MobileNav" aria-expanded="false">
      {% render 'icon', name: 'menu' %}<span class="visually-hidden">{{ 'accessibility.open_menu' | t }}</span>
    </button>
    <a class="header__logo" href="{{ routes.root_url }}" style="color:var(--c-primary)">
      {%- if settings.logo -%}
        {{ settings.logo | image_url: width: 480 | image_tag: width: settings.logo_width, alt: shop.name, loading: 'eager' }}
      {%- else -%}
        {% render 'logo', width: settings.logo_width %}
      {%- endif -%}
    </a>
    <nav class="header__nav" aria-label="Hoofdmenu">
      {%- if menu.links.size > 0 -%}
      <ul>
        {%- for link in menu.links -%}
          <li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a></li>
        {%- endfor -%}
      </ul>
      {%- endif -%}
    </nav>
    <div class="header__actions">
      <a href="{{ routes.search_url }}" class="icon-btn">{% render 'icon', name: 'search' %}<span class="visually-hidden">{{ 'general.search' | t }}</span></a>
      <a href="{{ routes.cart_url }}" class="icon-btn" data-drawer-open>
        {% render 'icon', name: 'cart' %}
        <span class="visually-hidden">{{ 'header.cart' | t }}, {{ 'accessibility.cart_count' | t: count: cart.item_count }}</span>
        <span class="cart-count" data-cart-count aria-hidden="true"{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>
<div id="MobileNav" class="mobile-nav" aria-hidden="true" role="dialog" aria-modal="true" aria-label="{{ 'general.menu' | t }}">
  <div class="mobile-nav__backdrop" data-menu-close></div>
  <div class="mobile-nav__panel">
    <button type="button" class="icon-btn" data-menu-close>{% render 'icon', name: 'close' %}<span class="visually-hidden">{{ 'accessibility.close_menu' | t }}</span></button>
    {%- if menu.links.size > 0 -%}
    <ul>
      {%- for link in menu.links -%}<li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a></li>{%- endfor -%}
    </ul>
    {%- endif -%}
    {% render 'trust-list' %}
  </div>
</div>
{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" }
  ]
}
{% endschema %}
