<section class="section text-center">
  <div class="container" style="max-width:560px">
    <div style="color:var(--c-primary);display:flex;justify-content:center;margin-bottom:24px">{% render 'logo', width: 220 %}</div>
    <h1>{{ section.settings.heading }}</h1>
    {%- if shop.password_message != blank -%}<p class="lead">{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'customer', class: 'newsletter-form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter,prelaunch">
      {%- if form.posted_successfully? -%}
        <p class="form-success" role="status">{{ 'newsletter.success' | t }}</p>
      {%- else -%}
        <label for="PwEmail" class="visually-hidden">{{ 'newsletter.label' | t }}</label>
        <input id="PwEmail" class="input" type="email" name="contact[email]" autocomplete="email" required placeholder="{{ 'newsletter.label' | t }}">
        <button class="btn btn--primary" type="submit">{{ 'newsletter.submit' | t }}</button>
      {%- endif -%}
    {%- endform -%}
    <details style="margin-top:40px">
      <summary class="small">{{ 'general.password.login' | t }}</summary>
      {%- form 'storefront_password', class: 'newsletter-form' -%}
        {%- if form.errors -%}<div class="form-errors">{{ form.errors | default_errors }}</div>{%- endif -%}
        <label for="Password" class="visually-hidden">{{ 'general.password.label' | t }}</label>
        <input id="Password" class="input" type="password" name="password" autocomplete="current-password" placeholder="{{ 'general.password.label' | t }}">
        <button class="btn btn--secondary" type="submit">{{ 'general.password.enter' | t }}</button>
      {%- endform -%}
    </details>
  </div>
</section>
{% schema %}
{ "name": "Wachtwoordpagina", "settings": [ { "type": "text", "id": "heading", "label": "Kop", "default": "Lobbes opent binnenkort" } ] }
{% endschema %}
