<section class="hero" aria-labelledby="Hero-{{ section.id }}">
  <div class="container hero__grid">
    <div class="hero__copy">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h1 id="Hero-{{ section.id }}">{{ section.settings.heading }}</h1>
      {%- if section.settings.text != blank -%}<div class="lead">{{ section.settings.text }}</div>{%- endif -%}
      <div class="hero__ctas">
        {%- if section.settings.button_label != blank -%}<a class="btn btn--primary" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>{%- endif -%}
        {%- if section.settings.button2_label != blank -%}<a class="btn btn--secondary" href="{{ section.settings.button2_link }}">{{ section.settings.button2_label }}</a>{%- endif -%}
      </div>
      {%- if section.blocks.size > 0 -%}
      <ul class="hero__checks">
        {%- for block in section.blocks -%}<li {{ block.shopify_attributes }}>{% render 'icon', name: 'check' %}{{ block.settings.text }}</li>{%- endfor -%}
      </ul>
      {%- endif -%}
    </div>
    <div class="hero__media">
      {% render 'media-or-fallback', image: section.settings.image, fallback: section.settings.fallback, alt: section.settings.image_alt, sizes: '(min-width: 990px) 50vw, 100vw', eager: true %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Bovenkop", "default": "Nieuw: de Onderweg-fles" },
    { "type": "text", "id": "heading", "label": "Kop", "default": "Water én brokjes in één fles." },
    { "type": "richtext", "id": "text", "label": "Tekst", "default": "<p>Geen losse bakjes, flesjes en zakjes meer. Boven de brokjes, onder het water: één klik op slot en hij gaat mee op elk rondje.</p>" },
    { "type": "text", "id": "button_label", "label": "Knop 1", "default": "Bekijk de Onderweg-fles" },
    { "type": "url", "id": "button_link", "label": "Knop 1 link" },
    { "type": "text", "id": "button2_label", "label": "Knop 2", "default": "Zo werkt het" },
    { "type": "text", "id": "button2_link", "label": "Knop 2 link (pad of anker, bijv. #hoe-het-werkt)", "default": "#hoe-het-werkt" },
    { "type": "image_picker", "id": "image", "label": "Afbeelding (vierkant, min. 1200px)" },
    { "type": "text", "id": "fallback", "label": "Reserve-afbeelding (asset)", "default": "fles-ijsblauw.svg" },
    { "type": "text", "id": "image_alt", "label": "Alt-tekst", "default": "Lobbes Onderweg-fles met voervak en waterreservoir" }
  ],
  "blocks": [ { "type": "check", "name": "Voordeel", "settings": [ { "type": "text", "id": "text", "label": "Tekst", "default": "Voordeel" } ] } ],
  "max_blocks": 4,
  "presets": [ { "name": "Hero" } ]
}
{% endschema %}
