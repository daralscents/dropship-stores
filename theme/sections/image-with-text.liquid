<section class="section {{ section.settings.style }}">
  <div class="container media-text{% if section.settings.reverse %} media-text--reverse{% endif %}">
    <div class="media-text__media">
      {% render 'media-or-fallback', image: section.settings.image, fallback: section.settings.fallback, alt: section.settings.heading, sizes: '(min-width: 990px) 50vw, 100vw' %}
    </div>
    <div>
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      <div class="rte">{{ section.settings.text }}</div>
      {%- if section.settings.button_label != blank -%}<p><a class="btn btn--primary" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a></p>{%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Afbeelding met tekst",
  "settings": [
    { "type": "select", "id": "style", "label": "Achtergrond", "options": [ {"value":"","label":"Zand"}, {"value":"section--surface","label":"Klei"}, {"value":"section--white","label":"Wit"} ], "default": "" },
    { "type": "checkbox", "id": "reverse", "label": "Afbeelding rechts", "default": false },
    { "type": "image_picker", "id": "image", "label": "Afbeelding" },
    { "type": "text", "id": "fallback", "label": "Reserve-afbeelding (asset)", "default": "lobbes-beeldmerk.svg" },
    { "type": "text", "id": "eyebrow", "label": "Bovenkop" },
    { "type": "text", "id": "heading", "label": "Kop", "default": "Kop" },
    { "type": "richtext", "id": "text", "label": "Tekst", "default": "<p>Tekst</p>" },
    { "type": "text", "id": "button_label", "label": "Knop" },
    { "type": "url", "id": "button_link", "label": "Knop link" }
  ],
  "presets": [ { "name": "Afbeelding met tekst" } ]
}
{% endschema %}
