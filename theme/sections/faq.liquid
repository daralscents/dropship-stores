<section class="section {{ section.settings.style }}" id="{{ section.settings.anchor | default: 'faq' }}">
  <div class="container">
    <div class="section-head">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="lead">{{ section.settings.text }}</div>{%- endif -%}
    </div>
    <div class="faq accordion">
      {%- for block in section.blocks -%}
        <details {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }}</summary>
          <div class="accordion__body rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
    {%- if section.settings.link_label != blank -%}<p class="text-center" style="margin-top:28px"><a class="link-arrow" href="{{ section.settings.link }}">{{ section.settings.link_label }}</a></p>{%- endif -%}
  </div>
</section>
{%- if section.settings.schema and section.blocks.size > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for block in section.blocks -%}
    { "@type": "Question", "name": {{ block.settings.question | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} } }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}
{% schema %}
{
  "name": "Veelgestelde vragen",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anker-ID", "default": "faq" },
    { "type": "select", "id": "style", "label": "Achtergrond", "options": [ {"value":"","label":"Zand"}, {"value":"section--surface","label":"Klei"}, {"value":"section--white","label":"Wit"} ], "default": "" },
    { "type": "text", "id": "eyebrow", "label": "Bovenkop" },
    { "type": "text", "id": "heading", "label": "Kop", "default": "Veelgestelde vragen" },
    { "type": "richtext", "id": "text", "label": "Intro" },
    { "type": "text", "id": "link_label", "label": "Link tekst" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "checkbox", "id": "schema", "label": "FAQ structured data toevoegen", "info": "Zet maar op één sectie per pagina aan.", "default": true }
  ],
  "blocks": [ { "type": "qa", "name": "Vraag", "settings": [
    { "type": "text", "id": "question", "label": "Vraag", "default": "Vraag?" },
    { "type": "richtext", "id": "answer", "label": "Antwoord", "default": "<p>Antwoord.</p>" }
  ] } ],
  "presets": [ { "name": "Veelgestelde vragen" } ]
}
{% endschema %}
