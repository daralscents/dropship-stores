<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ shop.name }} – {{ 'general.password.title' | t }}</title>
    <meta name="robots" content="noindex">
    <link rel="icon" type="image/svg+xml" href="{{ 'lobbes-beeldmerk.svg' | asset_url }}">
    <style>
      {{ settings.type_body_font | font_face: font_display: 'swap' }}
      :root{--c-primary:{{ settings.color_primary }};--c-bg:{{ settings.color_background }};--c-accent:{{ settings.color_accent }};--c-surface:{{ settings.color_surface }};--c-text:{{ settings.color_text }};--c-muted:{{ settings.color_muted }};--f-body:{{ settings.type_body_font.family }},{{ settings.type_body_font.fallback_families }};--f-head:var(--f-body);--fw-head:700}
    </style>
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body>
    <main id="main">{{ content_for_layout }}</main>
  </body>
</html>
